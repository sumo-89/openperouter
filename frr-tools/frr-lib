# Sourced by frr-start and frr-restart.

reason=/var/run/frr/frr-start.reason
watchfrr_pidfile=/var/run/frr/frr-start.watchfrr.pid

frr_names() {
	# shellcheck source=/dev/null
	. /usr/lib/frr/frrcommon.sh
	local d names=""
	for d in $(daemon_list); do
		names="$names ${d%%-*}"
	done
	echo "${names# }"
}

# Matches on comm: pgrep -x does not match the FRR daemons.
frr_pids() {
	local p comm names=" $* "
	for p in /proc/[0-9]*; do
		comm=$(cat "$p/comm" 2>/dev/null) || continue
		case "$names" in
		*" $comm "*)
			[ "$(awk '{print $3}' "$p/stat" 2>/dev/null)" = Z ] && continue
			echo "${p#/proc/}"
			;;
		esac
	done
}

describe() {
	local pid
	for pid in "$@"; do
		printf '%s(%s,uid %s) ' "$(cat "/proc/$pid/comm" 2>/dev/null)" "$pid" \
			"$(awk '/^Uid:/{print $2}' "/proc/$pid/status" 2>/dev/null)"
	done
}

# Prints why and returns 1 when a process cannot be killed or survives 10 s.
kill_and_wait() {
	local pids pid err failed=""
	pids=$(frr_pids "$@")
	[ -z "$pids" ] && return 0
	for pid in $pids; do
		err=$(kill -KILL "$pid" 2>&1) || failed="$failed $pid: ${err:-kill failed};"
	done
	if [ -n "$failed" ]; then
		echo "cannot stop $(describe $pids)(${failed# }); the frr container needs CAP_KILL"
		return 1
	fi
	for _ in $(seq 1 100); do
		[ -z "$(frr_pids "$@")" ] && return 0
		sleep 0.1
	done
	# shellcheck disable=SC2046
	echo "$(describe $(frr_pids "$@"))survived SIGKILL for 10 s"
	return 1
}
